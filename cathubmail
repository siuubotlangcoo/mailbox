function F.setStatus(text, color)
	if S.isDestroyed then return end
	UI.StatusLabel.Text = tostring(text)
	UI.StatusLabel.TextColor3 = color or Color3.fromRGB(165, 205, 180)
end

function F.setProgress(ratio)
	if S.isDestroyed then return end
	F.tweenProp(UI.ProgressFill, { Size = UDim2.new(math.clamp(ratio or 0, 0, 1), 0, 1, 0) }, 0.14)
end

function F.updateDiamondsUI()
	if S.isDestroyed then return end
	UI.DiamondLabel.Text = "Gems: " .. F.formatCompact(F.getDiamonds())
end

function F.getSanitizedQty()
	local cleaned = string.gsub(UI.QtyBox.Text or "", "%D", "")
	local n = tonumber(cleaned)
	if not n or not F.isValidFiniteNumber(n) or n < 1 then return 0 end
	return math.floor(n)
end

function F.getSanitizedDelay()
	local cleaned = string.gsub(UI.DelayBox.Text or "", ",", ".")
	local n = tonumber(cleaned)
	if not n or not F.isValidFiniteNumber(n) then return Cfg.DEFAULT_SEND_DELAY end
	return math.clamp(n, Cfg.MIN_SEND_DELAY, 30)
end

