-- Utility Helpers
function F.trackConn(conn)
	if conn then
		table.insert(S.connections, conn)
	end
	return conn
end

function F.trackThread(th)
	for i = #S.activeThreads, 1, -1 do
		local old = S.activeThreads[i]
		if not old or coroutine.status(old) == "dead" then
			table.remove(S.activeThreads, i)
		end
	end
	if th then
		table.insert(S.activeThreads, th)
	end
	return th
end

function F.clearConnList(list)
	for i = #list, 1, -1 do
		local c = list[i]
		if c and c.Connected then
			c:Disconnect()
		end
		list[i] = nil
	end
end

function F.tweenProp(inst, props, dur)
	if not inst or not inst.Parent then
		return nil
	end
	local ok, tw = pcall(function()
		local t = TweenService:Create(inst, TweenInfo.new(dur or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
		t:Play()
		return t
	end)
	return ok and tw or nil
end

function F.isValidFiniteNumber(n)
	return type(n) == "number" and n == n and math.abs(n) ~= math.huge
end

function F.trimString(str)
	if type(str) ~= "string" then
		return ""
	end
	return string.match(string.gsub(str, "%c", ""), "^%s*(.-)%s*$") or ""
end

function F.formatNumber(n)
	if not F.isValidFiniteNumber(n) then
		return "0"
	end
	local s = tostring(math.abs(math.floor(n)))
	while true do
		local k
		s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return (n < 0 and "-" or "") .. s
end

function F.formatCompact(n)
	if not F.isValidFiniteNumber(n) then
		return "0"
	end
	local a = math.abs(n)
	if a >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif a >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif a >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	return F.formatNumber(n)
end

function F.formatEta(seconds)
	if not F.isValidFiniteNumber(seconds) or seconds <= 0 then
		return "0s"
	end
	local s = math.floor(seconds + 0.5)
	if s >= 60 then
		return string.format("%dm%02ds", math.floor(s / 60), s % 60)
	end
	return tostring(s) .. "s"
end

function F.normalizeAssetId(raw)
	if type(raw) == "number" and F.isValidFiniteNumber(raw) and raw > 0 then
		return "rbxassetid://" .. tostring(math.floor(raw))
	end
	if type(raw) == "string" and raw ~= "" then
		if string.find(raw, "://", 1, true) then
			return raw
		end
		if string.match(raw, "^%d+$") then
			return "rbxassetid://" .. raw
		end
	end
	return ""
end

-- Persistent Sent Log Helpers
function F.loadSentLogFromFile()
	S.sentLogSet = {}
	S.sentLogCount = 0
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return
	end
	local okEx, ex = pcall(isfile, Cfg.SENT_LOG_FILE)
	if not okEx or not ex then
		return
	end
	local okRd, content = pcall(readfile, Cfg.SENT_LOG_FILE)
	if not okRd or type(content) ~= "string" then
		return
	end
	for line in string.gmatch(content, "[^\r\n]+") do
		local clean = F.trimString(line)
		if clean ~= "" then
			local low = string.lower(clean)
			if not S.sentLogSet[low] then
				S.sentLogSet[low] = true
				S.sentLogCount = S.sentLogCount + 1
			end
		end
	end
end

function F.recordSentLog(username)
	if type(username) ~= "string" or username == "" then
		return
	end
	local low = string.lower(username)
	if S.sentLogSet[low] then
		return
	end
	S.sentLogSet[low] = true
	S.sentLogCount = S.sentLogCount + 1
	if type(appendfile) == "function" then
		pcall(appendfile, Cfg.SENT_LOG_FILE, username .. "\n")
	elseif type(writefile) == "function" then
		local prev = ""
		if type(isfile) == "function" and type(readfile) == "function" then
			local okEx, ex = pcall(isfile, Cfg.SENT_LOG_FILE)
			if okEx and ex then
				local okRd, rd = pcall(readfile, Cfg.SENT_LOG_FILE)
				if okRd and type(rd) == "string" then
					prev = rd
				end
			end
		end
		pcall(writefile, Cfg.SENT_LOG_FILE, prev .. username .. "\n")
	end
end

function F.clearSentLogFile()
	S.sentLogSet = {}
	S.sentLogCount = 0
	if type(writefile) == "function" then
		pcall(writefile, Cfg.SENT_LOG_FILE, "")
	elseif type(delfile) == "function" and type(isfile) == "function" then
		local okEx, ex = pcall(isfile, Cfg.SENT_LOG_FILE)
		if okEx and ex then
			pcall(delfile, Cfg.SENT_LOG_FILE)
		end
	end
end

-- Event-driven anti-hang wrapper
function F.callWithTimeout(fn, timeoutSec, cancelableBySend, ...)
	if type(fn) ~= "function" then
		return false, "not_a_function", false, nil
	end
	local args = { ... }
	local argCount = select("#", ...)
	local caller = coroutine.running()
	local done, waiting, ok, r1, r2, timeoutThread = false, false, false, nil, nil, nil

	local th = task.spawn(function()
		ok, r1, r2 = pcall(fn, unpackFn(args, 1, argCount))
		done = true
		if timeoutThread then
			pcall(task.cancel, timeoutThread)
			timeoutThread = nil
		end
		if cancelableBySend and S.activeTimeoutThread then
			S.activeTimeoutThread = nil
		end
		if waiting then
			waiting = false
			if coroutine.status(caller) == "suspended" then
				task.spawn(caller)
			end
		end
	end)

	if not done then
		waiting = true
		if cancelableBySend then
			S.activeInvokeThread = th
		end
		timeoutThread = task.delay(timeoutSec or Cfg.CALL_TIMEOUT_FAST, function()
			if not done and waiting then
				waiting = false
				if coroutine.status(caller) == "suspended" then
					task.spawn(caller)
				end
			end
		end)
		if cancelableBySend then
			S.activeTimeoutThread = timeoutThread
		end
		coroutine.yield()
	end

	if cancelableBySend then
		if S.activeInvokeThread == th then
			S.activeInvokeThread = nil
		end
		if S.activeTimeoutThread == timeoutThread then
			S.activeTimeoutThread = nil
		end
	end
	if timeoutThread then
		pcall(task.cancel, timeoutThread)
		timeoutThread = nil
	end
	if not done then
		if coroutine.status(th) ~= "dead" then
			pcall(task.cancel, th)
		end
		return false, "Timeout (" .. tostring(timeoutSec) .. "s)", true, nil
	end
	return ok, r1, false, r2
end

function F.requireWithTimeout(inst, timeoutSec)
	if not inst or not inst:IsA("ModuleScript") then
		return nil
	end
	local ok, mod, timedOut = F.callWithTimeout(require, timeoutSec or Cfg.REQUIRE_TIMEOUT, false, inst)
	if ok and not timedOut and type(mod) == "table" then
		return mod
	end
	return nil
end

function F.getItemAmount(item)
	local raw = rawget(item, "_am") or rawget(item, "am") or rawget(item, "amount")
	if F.isValidFiniteNumber(raw) and raw >= 1 then
		return math.floor(raw)
	end
	return 1
end

function F.isItemLocked(item)
	return rawget(item, "_lk") == true or rawget(item, "lk") == true
end

function F.isItemMarkedEquipped(item)
	return rawget(item, "_eq") == true or rawget(item, "eq") == true
end

function F.getItemMutationInfo(item)
	local ptRaw = rawget(item, "pt")
	local pt = (ptRaw == 1 or ptRaw == 2) and ptRaw or 0
	local sh = (rawget(item, "sh") == true)
	local baseKey = (pt == 2 and sh and "shiny_rainbow")
		or (pt == 1 and sh and "shiny_golden")
		or (sh and "shiny")
		or (pt == 2 and "rainbow")
		or (pt == 1 and "golden")
		or "normal"

	local extras = {}
	local fields = { "mutation", "mutations", "mut", "mt", "_mt", "variant", "traits" }
	for i = 1, #fields do
		local val = rawget(item, fields[i])
		if type(val) == "string" and val ~= "" then
			table.insert(extras, val)
		elseif type(val) == "table" then
			for k, v in pairs(val) do
				if type(v) == "string" and v ~= "" then
					table.insert(extras, v)
				elseif v == true and type(k) == "string" and k ~= "" then
					table.insert(extras, k)
				end
			end
		end
	end
	return (#extras > 0 and ("extra:" .. string.lower(extras[1])) or baseKey), baseKey, extras, pt, sh
end

function F.itemMatchesExactMutation(item, targetMutKey)
	if targetMutKey == "all" or targetMutKey == "huge" then
		return true
	end
	local primaryKey, baseKey, extras = F.getItemMutationInfo(item)
	if string.sub(targetMutKey, 1, 6) == "extra:" then
		local wanted = string.sub(targetMutKey, 7)
		for i = 1, #extras do
			if string.lower(extras[i]) == wanted then
				return true
			end
		end
		return false
	end
	return primaryKey == targetMutKey or (primaryKey == baseKey and baseKey == targetMutKey)
end

function F.initGameModulesAsync()
	if S.modulesLoaded then
		return
	end
	local libInst = ReplicatedStorage:FindFirstChild("Library") or ReplicatedStorage:WaitForChild("Library", 5)
	if not libInst then
		return
	end
	local clientFolder = libInst:FindFirstChild("Client")
	local balancingFolder = libInst:FindFirstChild("Balancing")
	local typesFolder = libInst:FindFirstChild("Types")
	S.DirectoryFolder = libInst:FindFirstChild("Directory")

	local pending = 0
	local function spawnLoad(inst, timeoutSec, onLoaded)
		if not inst or not inst:IsA("ModuleScript") then
			return
		end
		pending = pending + 1
		task.spawn(function()
			local mod = F.requireWithTimeout(inst, timeoutSec)
			if mod and not S.isDestroyed then
				onLoaded(mod)
			end
			pending = pending - 1
		end)
	end

	spawnLoad(S.DirectoryFolder, 1.8, function(dirMod)
		local okP, tbl = pcall(function() return dirMod.Pets end)
		if okP and type(tbl) == "table" and next(tbl) ~= nil then S.PetDirectory = tbl end
	end)
	if S.DirectoryFolder then
		spawnLoad(S.DirectoryFolder:FindFirstChild("Pets"), 1.8, function(tbl)
			if next(S.PetDirectory) == nil then S.PetDirectory = tbl end
		end)
	end
	spawnLoad(clientFolder and clientFolder:FindFirstChild("Save") or libInst:FindFirstChild("Save"), 1.0, function(m) S.SaveMod = m end)
	spawnLoad(clientFolder and clientFolder:FindFirstChild("Network"), 0.8, function(m) S.NetworkMod = m end)
	spawnLoad(clientFolder and clientFolder:FindFirstChild("PetNetworking"), 0.8, function(m) S.PetNetworking = m end)
	spawnLoad(clientFolder and clientFolder:FindFirstChild("FFlags"), 0.8, function(m) S.FFlagsMod = m end)
	spawnLoad(balancingFolder and balancingFolder:FindFirstChild("Constants"), 0.8, function(m) S.ConstantsMod = m end)
	spawnLoad(typesFolder and typesFolder:FindFirstChild("Mailbox"), 0.8, function(m) S.MailboxTypesMod = m end)

	local deadline = os.clock() + 2.0
	while pending > 0 and os.clock() < deadline and not S.isDestroyed do
		task.wait(0.04)
	end
	S.modulesLoaded = true
end

function F.scoreSaveTable(t)
	if type(t) ~= "table" then return 0 end
	local inv = rawget(t, "Inventory")
	if type(inv) ~= "table" then return 0 end
	local pets = rawget(inv, "Pet")
	if type(pets) ~= "table" then return 0 end
	local score = 1
	if type(rawget(inv, "Currency")) == "table" then score = score + 4 end
	if rawget(t, "Rebirths") ~= nil then score = score + 2 end
	if rawget(t, "Rank") ~= nil then score = score + 2 end
	if rawget(t, "UnlockedZones") ~= nil then score = score + 2 end
	if rawget(t, "MailboxSendsSinceReset") ~= nil or rawget(t, "MailboxResetTime") ~= nil then score = score + 2 end
	if rawget(t, "Achievements") ~= nil then score = score + 1 end
	if score < 3 then return 0 end
	local petSlots = 0
	for _ in pairs(pets) do
		petSlots = petSlots + 1
		if petSlots >= 20 then break end
	end
	return score * 100 + petSlots
end

function F.extractSaveFromResult(res)
	if type(res) ~= "table" then return nil end
	if F.scoreSaveTable(res) > 0 then return res end
	local inner = rawget(res, "Save")
	if type(inner) == "table" and F.scoreSaveTable(inner) > 0 then return inner end
	return nil
end

function F.resolveLiveSave(forceRescan, progressCb)
	if not forceRescan and S.cachedSaveTable and F.scoreSaveTable(S.cachedSaveTable) > 0 then
		return S.cachedSaveTable, S.activeSaveSource
	end
	if not S.saveModDead and type(S.SaveMod) == "table" then
		for _, fnName in ipairs({ "Get", "GetData", "GetSave" }) do
			local fn = rawget(S.SaveMod, fnName)
			if type(fn) == "function" then
				local ok1, res1, to1 = F.callWithTimeout(fn, Cfg.CALL_TIMEOUT_FAST, false)
				if to1 then S.saveModDead = true break end
				local s1 = ok1 and F.extractSaveFromResult(res1) or nil
				if s1 then
					S.cachedSaveTable = s1
					S.activeSaveSource = "Save." .. fnName
					return s1, S.activeSaveSource
				end
			end
		end
	end

	if type(getgc) == "function" then
		if progressCb then progressCb("Scanning memory (GC)...") end
		local okGc, gcList = pcall(getgc, true)
		if okGc and type(gcList) == "table" then
			local totalObjs, bestTable, bestScore, startClock, scanned = #gcList, nil, 0, os.clock(), 0
			for i = totalObjs, 1, -1 do
				if S.isDestroyed then return nil, "Closed" end
				scanned = scanned + 1
				local obj = gcList[i]
				if type(obj) == "table" then
					if rawget(obj, "Inventory") ~= nil then
						local sc = F.scoreSaveTable(obj)
						if sc > bestScore then
							bestScore, bestTable = sc, obj
							if bestScore >= 901 then
								S.cachedSaveTable = bestTable
								S.activeSaveSource = "GC-Fast"
								return bestTable, S.activeSaveSource
							end
						end
					elseif not S.cachedGcPetNet and type(rawget(obj, "EquippedPets")) == "function" then
						S.cachedGcPetNet = obj
					elseif not S.cachedGcNetwork and type(rawget(obj, "Invoke")) == "function" and type(rawget(obj, "Fire")) == "function" then
						if type(rawget(obj, "Fired")) == "function" or type(rawget(obj, "Invoked")) == "function" then
							S.cachedGcNetwork = obj
						end
					end
				end
				if scanned % Cfg.GC_YIELD_STEP == 0 then
					if progressCb then progressCb(string.format("Scanning GC (%d%%)...", math.floor((scanned / totalObjs) * 100))) end
					if os.clock() - startClock > Cfg.GC_TIME_BUDGET then break end
					task.wait()
				end
			end
			if bestTable then
				S.cachedSaveTable = bestTable
				S.activeSaveSource = "GC-Table"
				return bestTable, S.activeSaveSource
			end
		end
	end

	local getUpvaluesFn = (type(debug) == "table" and debug.getupvalues) or getupvalues
	local debugInfoFn = type(debug) == "table" and debug.info or nil
	if type(getgc) == "function" and type(getUpvaluesFn) == "function" then
		if progressCb then progressCb("Scanning Upvalues...") end
		local okGc, gcFuncs = pcall(getgc, false)
		if okGc and type(gcFuncs) == "table" then
			local bestTable, bestScore, startClock = nil, 0, os.clock()
			for i = 1, #gcFuncs do
				if S.isDestroyed then return nil, "Closed" end
				local fn = gcFuncs[i]
				if type(fn) == "function" then
					local inspect = true
					if debugInfoFn then
						local okI, src = pcall(debugInfoFn, fn, "s")
						if okI and type(src) == "string" then
							local ls = string.lower(src)
							inspect = string.find(ls, "save", 1, true) ~= nil or string.find(ls, "inventory", 1, true) ~= nil or string.find(ls, "client", 1, true) ~= nil
						end
					end
					if inspect then
						local okUp, ups = pcall(getUpvaluesFn, fn)
						if okUp and type(ups) == "table" then
							for _, val in pairs(ups) do
								if type(val) == "table" and rawget(val, "Inventory") ~= nil then
									local sc = F.scoreSaveTable(val)
									if sc > bestScore then
										bestScore, bestTable = sc, val
										if bestScore >= 901 then
											S.cachedSaveTable = bestTable
											S.activeSaveSource = "GC-Upvalue"
											return bestTable, S.activeSaveSource
										end
									end
								end
							end
						end
					end
				end
				if i % 4000 == 0 then
					if os.clock() - startClock > Cfg.GC_TIME_BUDGET then break end
					task.wait()
				end
			end
			if bestTable then
				S.cachedSaveTable = bestTable
				S.activeSaveSource = "GC-Upvalue"
				return bestTable, S.activeSaveSource
			end
		end
	end

	S.cachedSaveTable = nil
	S.activeSaveSource = "Failed to read Save"
	return nil, S.activeSaveSource
end

function F.getEquippedCountByUid(save)
	local counts = {}
	local function ingest(tbl)
		if type(tbl) ~= "table" then return end
		for k, v in pairs(tbl) do
			if type(v) == "table" then
				local uid = rawget(v, "uid") or rawget(v, "_uid") or rawget(v, "UID")
				if type(uid) == "string" then counts[uid] = (counts[uid] or 0) + 1 end
			elseif type(v) == "string" then
				counts[v] = (counts[v] or 0) + 1
			elseif v == true and type(k) == "string" then
				counts[k] = (counts[k] or 0) + 1
			end
		end
	end

	if not S.petNetDead then
		local petNet = S.PetNetworking or S.cachedGcPetNet
		if type(petNet) == "table" then
			for _, fnName in ipairs({ "EquippedPets", "GetEquipped" }) do
				local fn = rawget(petNet, fnName)
				if type(fn) == "function" then
					local ok, res, timedOut = F.callWithTimeout(fn, Cfg.CALL_TIMEOUT_FAST, false)
					if timedOut then S.petNetDead = true break end
					if ok and type(res) == "table" then
						local lpEntry = res[LocalPlayer] or res[LocalPlayer.UserId]
						ingest(type(lpEntry) == "table" and lpEntry or res)
						return counts
					end
				end
			end
		end
	end
	if type(save) == "table" then ingest(rawget(save, "EquippedPets")) end
	return counts
end

function F.getDiamonds()
	local best = 0
	local save = S.cachedSaveTable
	local inv = save and rawget(save, "Inventory")
	local curr = type(inv) == "table" and rawget(inv, "Currency") or nil
	if type(curr) == "table" then
		local total = 0
		for _, item in pairs(curr) do
			if type(item) == "table" and rawget(item, "id") == "Diamonds" then
				total = total + F.getItemAmount(item)
			end
		end
		if total > best then best = total end
	end
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	if ls then
		for _, child in ipairs(ls:GetChildren()) do
			if (child:IsA("NumberValue") or child:IsA("IntValue")) and string.find(string.lower(child.Name), "diamond", 1, true) then
				if F.isValidFiniteNumber(child.Value) and child.Value > best then best = math.floor(child.Value) end
			end
		end
	end
	return best
end

function F.getMailboxSendCost()
	local baseCost = 20000
	if type(S.ConstantsMod) == "table" and F.isValidFiniteNumber(rawget(S.ConstantsMod, "MailboxDiamondCost")) then
		baseCost = math.floor(rawget(S.ConstantsMod, "MailboxDiamondCost"))
	end
	local feeMult = 1
	if type(S.FFlagsMod) == "table" and type(rawget(S.FFlagsMod, "Get")) == "function" and type(rawget(S.FFlagsMod, "Keys")) == "table" then
		local okM, valM = pcall(function() return S.FFlagsMod.Get(S.FFlagsMod.Keys.DiamondSink_MailboxFee_Mult) end)
		if okM and type(valM) == "number" and F.isValidFiniteNumber(valM) and valM > 0 then feeMult = valM end
	end
	local flatCost = math.floor(baseCost * feeMult)
	if LocalPlayer:GetAttribute("Partner") == true then return flatCost end
	local save = S.cachedSaveTable
	if type(save) ~= "table" then return flatCost end
	local gp = rawget(save, "Gamepasses")
	if type(gp) == "table" and rawget(gp, "VIP") == true then return flatCost end

	local resetTime = rawget(save, "MailboxResetTime")
	local okNow, serverNow = pcall(function() return workspace:GetServerTimeNow() end)
	if not okNow or not F.isValidFiniteNumber(serverNow) or type(resetTime) ~= "number" or resetTime < serverNow then
		return flatCost
	end

	local sends = rawget(save, "MailboxSendsSinceReset")
	if not F.isValidFiniteNumber(sends) or sends < 0 then sends = 0 end
	local growthRate, costCap = 1.5, 5000000
	if type(S.MailboxTypesMod) == "table" then
		if F.isValidFiniteNumber(rawget(S.MailboxTypesMod, "DiamondCostGrowthRate")) then growthRate = rawget(S.MailboxTypesMod, "DiamondCostGrowthRate") end
		if F.isValidFiniteNumber(rawget(S.MailboxTypesMod, "DiamondCostCap")) then costCap = rawget(S.MailboxTypesMod, "DiamondCostCap") end
	end
	return math.min(math.floor(flatCost * math.pow(growthRate, sends)), math.floor(costCap * feeMult))
end

function F.findNearestMailboxPos()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local origin = root and root.Position or Vector3.new(0, 0, 0)
	if S.cachedMailboxPart and S.cachedMailboxPart.Parent and S.cachedMailboxPart:IsDescendantOf(workspace) then
		local pos = S.cachedMailboxPart.Position
		local dist = (pos - origin).Magnitude
		if dist < 2500 then return pos, dist end
	end
	S.cachedMailboxPart = nil

	local bestPos, bestPart, bestDist = nil, nil, math.huge
	local function considerPos(pos, partRef)
		if typeof(pos) ~= "Vector3" then return end
		local dist = (pos - origin).Magnitude
		if dist < bestDist then bestDist, bestPos, bestPart = dist, pos, partRef end
	end
	local function scanContainer(container)
		if not container then return end
		for _, obj in ipairs(container:GetDescendants()) do
			if obj:IsA("Model") or obj:IsA("BasePart") then
				if string.find(string.lower(obj.Name), "mailbox", 1, true) then
					if obj:IsA("BasePart") then
						considerPos(obj.Position, obj)
					else
						local pad = obj:FindFirstChild("Pad", true) or obj:FindFirstChild("Interact", true) or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
						if pad and pad:IsA("BasePart") then
							considerPos(pad.Position, pad)
						else
							local okP, cf = pcall(function() return obj:GetPivot() end)
							if okP and typeof(cf) == "CFrame" then considerPos(cf.Position, nil) end
						end
					end
				end
			elseif obj:IsA("TextLabel") then
				local txt = string.lower(obj.Text or "")
				if string.find(txt, "send and receive gifts", 1, true) or txt == "mailbox" then
					local anc = obj:FindFirstAncestorWhichIsA("BasePart")
					if anc then
						considerPos(anc.Position, anc)
					else
						local model = obj:FindFirstAncestorWhichIsA("Model")
						local anyPart = model and model:FindFirstChildWhichIsA("BasePart", true)
						if anyPart then considerPos(anyPart.Position, anyPart) end
					end
				end
			end
		end
	end

	local things = workspace:FindFirstChild("__THINGS")
	if things then scanContainer(things:FindFirstChild("Mailboxes")) end
	if not bestPos then
		local mapFolder = workspace:FindFirstChild("Map") or workspace:FindFirstChild("__MAP")
		if mapFolder then
			for _, z in ipairs(mapFolder:GetChildren()) do
				local inter = z:FindFirstChild("INTERACT")
				if inter then scanContainer(inter:FindFirstChild("Machines") or inter) end
			end
			if not bestPos then scanContainer(mapFolder) end
		end
	end
	if not bestPos then scanContainer(workspace) end
	if bestPart then S.cachedMailboxPart = bestPart end
	return bestPos, bestDist
end

function F.moveToPhysicalMailbox()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not root then return false, "Character not found" end
	local mbPos, dist = F.findNearestMailboxPos()
	if not mbPos then return false, "Mailbox TP not needed (EF_Relay sends anywhere)" end
	if dist <= Cfg.MAILBOX_MAX_DIST then return true, "Already near Mailbox" end
	pcall(function() char:PivotTo(CFrame.new(mbPos + Vector3.new(0, 3.5, 3), mbPos + Vector3.new(0, 2, 0))) end)
	task.wait(0.2)
	return true, "Moved to Mailbox"
end

function F.rebuildMutationRegistry(discoveredExtras)
	local newFilters, newMeta, addedExtra = {}, {}, {}
	for _, entry in ipairs(Cfg.FILTER_TABS) do
		table.insert(newFilters, entry)
		newMeta[entry.key] = entry
	end
	local function registerExtra(rawName)
		if type(rawName) ~= "string" or rawName == "" then return end
		local lower = string.lower(rawName)
		if lower == "normal" or lower == "base" or lower == "golden" or lower == "rainbow" or lower == "shiny" then return end
		local key = "extra:" .. lower
		if not addedExtra[key] then
			addedExtra[key] = true
			local entry = { key = key, label = rawName, short = string.upper(string.sub(rawName, 1, 6)), color = Color3.fromRGB(196, 86, 138) }
			table.insert(newFilters, entry)
			newMeta[key] = entry
		end
	end
	if S.cachedDirMutations == nil then
		S.cachedDirMutations = {}
		local rawDirRoot = ReplicatedStorage:FindFirstChild("__DIRECTORY")
		if rawDirRoot then
			for _, fName in ipairs({ "Mutations", "PetMutations" }) do
				local mf = rawDirRoot:FindFirstChild(fName)
				if mf then
					for _, child in ipairs(mf:GetDescendants()) do
						if child:IsA("ModuleScript") then
							table.insert(S.cachedDirMutations, string.match(child.Name, "^%d+%s*|%s*(.+)$") or child.Name)
						end
					end
				end
			end
		end
	end
	for _, m in ipairs(S.cachedDirMutations) do registerExtra(m) end
	for _, m in ipairs(discoveredExtras) do registerExtra(m) end

	local sigParts = {}
	for i = 1, #newFilters do sigParts[i] = newFilters[i].key end
	local sig = table.concat(sigParts, "|")
	local changed = (sig ~= S.lastMutationSignature)
	S.lastMutationSignature = sig
	S.activeFilters, S.filterMetaByKey = newFilters, newMeta
	if not S.filterMetaByKey[S.selectedMutFilter] then S.selectedMutFilter = "all" end
	return changed
end

function F.addStatBucket(petMap, mutKey, am, isLocked, eqInStack)
	local st = petMap[mutKey]
	if not st then
		st = { sendable = 0, equipped = 0, locked = 0, total = 0 }
		petMap[mutKey] = st
	end
	st.total = st.total + am
	if isLocked then
		st.locked = st.locked + am
	else
		st.equipped = st.equipped + eqInStack
		st.sendable = st.sendable + (S.skipEquipped and math.max(0, am - eqInStack) or am)
	end
end

function F.ensurePetRecord(petId)
	local lowerId = string.lower(petId)
	local existing = S.petByLowerId[lowerId]
	local dir = type(S.PetDirectory) == "table" and rawget(S.PetDirectory, petId) or nil
	if existing then
		if type(dir) == "table" then
			if existing.thumbnail == "" then
				local rawName = rawget(dir, "name")
				if type(rawName) == "string" and rawName ~= "" then
					existing.displayName, existing.lowerName = rawName, string.lower(rawName)
					existing.searchBlob = string.lower(rawName .. " " .. existing.petId)
				end
				local thumb = F.normalizeAssetId(rawget(dir, "thumbnail"))
				local goldThumb = F.normalizeAssetId(rawget(dir, "goldenThumbnail"))
				existing.thumbnail = (thumb ~= "" and thumb) or goldThumb
				existing.goldenThumbnail = (goldThumb ~= "" and goldThumb) or existing.thumbnail
				local pv = rawget(dir, "power")
				if F.isValidFiniteNumber(pv) then existing.power = pv end
			end
			if rawget(dir, "huge") == true then existing.isHuge, existing.isHugeOrTitanic = true, true end
			if rawget(dir, "titanic") == true or rawget(dir, "gargantuan") == true then existing.isHugeOrTitanic = true end
		end
		return existing
	end

	local displayName, thumb, goldThumb, power = petId, "", "", 0
	local isHuge = (string.sub(petId, 1, 5) == "Huge ")
	local isHugeOrTitanic = isHuge or (string.sub(petId, 1, 8) == "Titanic ") or (string.sub(petId, 1, 11) == "Gargantuan ")
	if type(dir) == "table" then
		local rawName = rawget(dir, "name")
		if type(rawName) == "string" and rawName ~= "" then displayName = rawName end
		thumb = F.normalizeAssetId(rawget(dir, "thumbnail"))
		goldThumb = F.normalizeAssetId(rawget(dir, "goldenThumbnail"))
		if thumb == "" then thumb = goldThumb end
		if goldThumb == "" then goldThumb = thumb end
		local pv = rawget(dir, "power")
		if F.isValidFiniteNumber(pv) then power = pv end
		if rawget(dir, "huge") == true then isHuge, isHugeOrTitanic = true, true end
		if rawget(dir, "titanic") == true or rawget(dir, "gargantuan") == true then isHugeOrTitanic = true end
	end
	local meta = S.dirOrderMap[lowerId] or S.dirOrderMap[string.lower(displayName)]
	local rec = {
		petId = petId, lowerId = lowerId, displayName = displayName, lowerName = string.lower(displayName),
		searchBlob = string.lower(displayName .. " " .. petId), thumbnail = thumb, goldenThumbnail = goldThumb,
		power = power, zoneNum = meta and meta.zoneNum or 0, dirOrder = meta and meta.order or 0,
		isHuge = isHuge, isHugeOrTitanic = isHugeOrTitanic,
	}
	S.petByLowerId[lowerId] = rec
	table.insert(S.allPets, rec)
	return rec
end

function F.sortPetsList(list)
	table.sort(list, function(a, b)
		if a.zoneNum ~= b.zoneNum then return a.zoneNum > b.zoneNum end
		if a.power ~= b.power then return a.power > b.power end
		if a.dirOrder ~= b.dirOrder then return a.dirOrder > b.dirOrder end
		return a.lowerName < b.lowerName
	end)
end

function F.refreshInventoryCounts(forceGc, progressCb, fastMode)
	S.statsByPetAndMut, S.ownedPetsList = {}, {}
	local discoveredExtras = {}
	local save, source = F.resolveLiveSave(forceGc, progressCb)
	local inv = save and rawget(save, "Inventory")
	local invPets = type(inv) == "table" and rawget(inv, "Pet") or nil
	if type(invPets) ~= "table" then
		if not fastMode then F.rebuildMutationRegistry(discoveredExtras) end
		return false, 0, 0, source, false
	end

	local eqCounts = F.getEquippedCountByUid(save)
	local totalSendableAll, uniqueVariantsCount, countedVariantKeys, ownedSeenLower = 0, 0, {}, {}
	for uid, item in pairs(invPets) do
		if type(uid) == "string" and type(item) == "table" then
			local id = rawget(item, "id")
			if type(id) == "string" and id ~= "" then
				local lowerId = string.lower(id)
				local am = F.getItemAmount(item)
				local locked = F.isItemLocked(item)
				local eqInStack = math.min(am, eqCounts[uid] or (F.isItemMarkedEquipped(item) and 1 or 0))
				local primaryKey, _, extras = F.getItemMutationInfo(item)

				local petMap = S.statsByPetAndMut[lowerId]
				if not petMap then petMap = {}; S.statsByPetAndMut[lowerId] = petMap end
				if not ownedSeenLower[lowerId] then
					ownedSeenLower[lowerId] = true
					table.insert(S.ownedPetsList, F.ensurePetRecord(id))
				end
				F.addStatBucket(petMap, primaryKey, am, locked, eqInStack)
				for _, exName in ipairs(extras) do
					table.insert(discoveredExtras, exName)
					local exKey = "extra:" .. string.lower(exName)
					if exKey ~= primaryKey then F.addStatBucket(petMap, exKey, am, locked, eqInStack) end
				end
				local pairKey = lowerId .. "\0" .. primaryKey
				if not countedVariantKeys[pairKey] then
					countedVariantKeys[pairKey] = true
					uniqueVariantsCount = uniqueVariantsCount + 1
				end
				if not locked then
					totalSendableAll = totalSendableAll + (S.skipEquipped and math.max(0, am - eqInStack) or am)
				end
			end
		end
	end
	F.sortPetsList(S.ownedPetsList)
	local mutChanged = (not fastMode or #discoveredExtras > 0) and F.rebuildMutationRegistry(discoveredExtras) or false
	return true, totalSendableAll, uniqueVariantsCount, source, mutChanged
end

function F.buildFullCatalogOnce(onDone)
	if S.catalogBuilt then
		if onDone then onDone() end
		return
	end
	S.catalogBuilt = true
	if type(S.PetDirectory) == "table" then
		local n = 0
		for petId, dir in pairs(S.PetDirectory) do
			if S.isDestroyed then return end
			if type(petId) == "string" and type(dir) == "table" then F.ensurePetRecord(petId) end
			n = n + 1
			if n % 800 == 0 then task.wait() end
		end
		F.sortPetsList(S.allPets)
		if onDone and not S.isDestroyed then onDone() end
	end
	if not S.dirOrderReady then
		S.dirOrderReady = true
		local rawDirRoot = ReplicatedStorage:FindFirstChild("__DIRECTORY")
		local rawPetsDir = rawDirRoot and rawDirRoot:FindFirstChild("Pets")
		if rawPetsDir then
			local desc, seq = rawPetsDir:GetDescendants(), 0
			for i = 1, #desc do
				if S.isDestroyed then return end
				local obj = desc[i]
				if obj:IsA("ModuleScript") then
					seq = seq + 1
					local rawName = obj.Name
					local cleanId = string.match(rawName, "^%d+%s*|%s*(.+)$") or rawName
					local zoneNum = tonumber(string.match(rawName, "^(%d+)")) or 0
					local parent = obj.Parent
					while parent and parent ~= rawPetsDir do
						local pNum = tonumber(string.match(parent.Name, "^(%d+)"))
						if pNum and pNum > zoneNum then zoneNum = pNum end
						parent = parent.Parent
					end
					local meta = { order = seq, zoneNum = zoneNum }
					local lowerClean = string.lower(cleanId)
					S.dirOrderMap[lowerClean], S.dirOrderMap[string.lower(rawName)] = meta, meta
					local rec = S.petByLowerId[lowerClean]
					if rec then rec.zoneNum, rec.dirOrder = zoneNum, seq end
				end
				if i % 600 == 0 then task.wait() end
			end
			F.sortPetsList(S.allPets)
			F.sortPetsList(S.ownedPetsList)
			if onDone and not S.isDestroyed then onDone() end
		end
	end
end

