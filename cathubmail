	end))

	F.trackConn(UI.CheckMailLogBtn.MouseButton1Click:Connect(function()
		local save = S.cachedSaveTable or F.resolveLiveSave(false)
		local mailLog = type(save) == "table" and rawget(save, "MailLog") or nil
		if type(mailLog) ~= "table" or #mailLog == 0 then F.setStatus("Could not read recent MailLog from Save.", Color3.fromRGB(245, 165, 95)) return end
		local sentList = {}
		for _, entry in ipairs(mailLog) do
			if type(entry) == "table" and rawget(entry, "Sender") == nil then
				local rn = rawget(entry, "RecieverName") or rawget(entry, "ReceiverName")
				if type(rn) == "string" and rn ~= "" then table.insert(sentList, { name = rn, ts = tonumber(rawget(entry, "Timestamp")) or 0 }) end
			end
		end
		if #sentList == 0 then F.setStatus("No outgoing MailLog entries found yet.", Color3.fromRGB(245, 165, 95)) return end
		table.sort(sentList, function(a, b) return a.ts > b.ts end)
		local preview, allNames = {}, {}
		for i, v in ipairs(sentList) do
			allNames[i] = v.name
			if i <= 5 then preview[i] = v.name end
		end
		if type(setclipboard) == "function" then pcall(setclipboard, table.concat(allNames, "\n")) end
		F.setStatus("Latest (" .. tostring(#sentList) .. " - copied): " .. table.concat(preview, ", "), Color3.fromRGB(125, 220, 255))
	end))
