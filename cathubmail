function F.collectDistinctRowsForPet(pet, ownedBucket, otherBucket)
	if S.selectedMutFilter == "huge" and not pet.isHuge then return end
	local petMap = S.statsByPetAndMut[pet.lowerId]
	if S.selectedMutFilter ~= "all" and S.selectedMutFilter ~= "huge" then
		local st = petMap and petMap[S.selectedMutFilter]
		local entry = { pet = pet, mutKey = S.selectedMutFilter }
		if st and st.total > 0 then table.insert(ownedBucket, entry)
		elseif #otherBucket < Cfg.MAX_RESULTS then table.insert(otherBucket, entry) end
		return
	end
	local ownedKeys = {}
	if petMap then
		for mutKey, st in pairs(petMap) do
			if st.total > 0 then table.insert(ownedKeys, mutKey) end
		end
	end
	if #ownedKeys > 0 then
		table.sort(ownedKeys, function(a, b)
			local oa, ob = Cfg.MUTATION_ORDER[a] or 50, Cfg.MUTATION_ORDER[b] or 50
			if oa ~= ob then return oa < ob end
			return a < b
		end)
		for _, k in ipairs(ownedKeys) do table.insert(ownedBucket, { pet = pet, mutKey = k }) end
	elseif #otherBucket < Cfg.MAX_RESULTS then
		table.insert(otherBucket, { pet = pet, mutKey = "normal" })
	end
end

function F.updateSearchResults(preserveScroll)
	local prevCanvas = preserveScroll and UI.ResultScroll.CanvasPosition or nil
	local query = string.lower(F.trimString(UI.SearchBox.Text))
	local matches = {}
	local function pushBuckets(buckets)
		for _, list in ipairs(buckets) do
			for _, entry in ipairs(list) do
				table.insert(matches, entry)
				if #matches >= Cfg.MAX_RESULTS then return end
			end
		end
	end

	if query == "" then
		local ownedRows, otherRows = {}, {}
		for _, p in ipairs(S.ownedPetsList) do
			F.collectDistinctRowsForPet(p, ownedRows, otherRows)
			if #ownedRows >= Cfg.MAX_RESULTS then break end
		end
		if #ownedRows < Cfg.MAX_RESULTS then
			for _, p in ipairs(S.allPets) do
				if not S.statsByPetAndMut[p.lowerId] then
					F.collectDistinctRowsForPet(p, ownedRows, otherRows)
					if #ownedRows + #otherRows >= Cfg.MAX_RESULTS then break end
				end
			end
		end
		pushBuckets({ ownedRows, otherRows })
	else
		local eO, eX, pO, pX, sO, sX = {}, {}, {}, {}, {}, {}
		for _, p in ipairs(S.ownedPetsList) do
			if p.lowerName == query then F.collectDistinctRowsForPet(p, eO, eX)
			elseif string.sub(p.lowerName, 1, #query) == query then F.collectDistinctRowsForPet(p, pO, pX)
			elseif string.find(p.searchBlob, query, 1, true) then F.collectDistinctRowsForPet(p, sO, sX) end
		end
		if #eO + #pO + #sO < Cfg.MAX_RESULTS then
			for _, p in ipairs(S.allPets) do
				if not S.statsByPetAndMut[p.lowerId] then
					if p.lowerName == query then F.collectDistinctRowsForPet(p, eO, eX)
					elseif string.sub(p.lowerName, 1, #query) == query then F.collectDistinctRowsForPet(p, pO, pX)
					elseif string.find(p.searchBlob, query, 1, true) then F.collectDistinctRowsForPet(p, sO, sX) end
					if #eX + #pX >= Cfg.MAX_RESULTS then break end
				end
			end
		end
		pushBuckets({ eO, pO, sO, eX, pX, sX })
	end

	for i = 1, Cfg.MAX_RESULTS do
		local slot, entry = S.resultSlots[i], matches[i]
		if entry then
			local pet, mutKey = entry.pet, entry.mutKey
			local meta = F.getMutationMeta(mutKey)
			local sendable, eqCount, lockedCount = F.getPetMutStats(pet.lowerId, mutKey)
			slot.entryRef, slot.Visible, slot.Button.Visible = entry, true, true
			slot.Icon.Image = F.getIconForMutation(pet, mutKey)
			slot.MutBadge.Text, slot.MutBadge.BackgroundColor3 = meta.short, meta.color
			slot.NameLabel.Text = pet.displayName
			if sendable > 0 then
				slot.CountLabel.Text, slot.CountLabel.TextColor3 = "x" .. F.formatNumber(sendable), Color3.fromRGB(125, 225, 165)
			elseif S.skipEquipped and eqCount > 0 then
				slot.CountLabel.Text, slot.CountLabel.TextColor3 = "0 (eq:" .. F.formatNumber(eqCount) .. ")", Color3.fromRGB(245, 185, 95)
			elseif lockedCount > 0 then
				slot.CountLabel.Text, slot.CountLabel.TextColor3 = "0 (lock:" .. F.formatNumber(lockedCount) .. ")", Color3.fromRGB(235, 130, 130)
			else
				slot.CountLabel.Text, slot.CountLabel.TextColor3 = "x0", Color3.fromRGB(100, 112, 132)
			end
		else
			slot.entryRef, slot.Visible, slot.Button.Visible = nil, false, false
		end
	end
	UI.ResultScroll.CanvasPosition = (preserveScroll and prevCanvas) or Vector2.new(0, 0)
	F.refreshSlotHighlights()
end

