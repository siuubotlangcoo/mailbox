	return S.filterMetaByKey[mutKey] or Cfg.FILTER_TABS[3]
end

function F.parseMultiRecipients(rawText)
	local text = rawText or ""
	if text == S.lastRecipRaw then return S.cachedRecipients, S.cachedInvalidCount end
	local valid, invalidCount, seen, selfLower = {}, 0, {}, string.lower(LocalPlayer.Name)
	for segment in string.gmatch(text, "([^|\r\n,;]+)") do
		local name = F.trimString(segment)
		if name ~= "" then
			local lower = string.lower(name)
			if lower ~= selfLower then
				if #name >= 3 and #name <= 20 and string.match(name, "^[A-Za-z0-9_]+$") then
					if not seen[lower] then seen[lower] = true; table.insert(valid, name) end
				else
					invalidCount = invalidCount + 1
				end
			end
		end
	end
	S.lastRecipRaw, S.cachedRecipients, S.cachedInvalidCount = text, valid, invalidCount
	return valid, invalidCount
end

function F.parseSingleRecipient(rawText)
	local name = F.trimString(rawText or "")
	local first = string.match(name, "([A-Za-z0-9_]+)") or ""
	if first == "" or #first < 3 or #first > 20 then return nil, "invalid" end
	if string.lower(first) == string.lower(LocalPlayer.Name) then return nil, "self" end
	return first, nil
end

function F.findMailboxRemote()
	if S.cachedMailboxRemote and S.cachedMailboxRemote.Parent then return S.cachedMailboxRemote end
	S.cachedMailboxRemote = nil
	local netFolder = ReplicatedStorage:FindFirstChild("Network")
	if netFolder then
		local relay = netFolder:FindFirstChild("EF_Relay")
		if relay and relay:IsA("RemoteFunction") then S.cachedMailboxRemote = relay; return relay end
		local exact = netFolder:FindFirstChild("Mailbox: Send")
		if exact and exact:IsA("RemoteFunction") then S.cachedMailboxRemote = exact; return exact end
		for _, child in ipairs(netFolder:GetChildren()) do
			if child:IsA("RemoteFunction") then
				local ln = string.lower(child.Name)
				if string.find(ln, "mailbox", 1, true) and string.find(ln, "send", 1, true) then
					S.cachedMailboxRemote = child; return child
				end
			end
		end
	end
	return nil
end

function F.invokeMailboxSend(recipient, message, uid, amount)
	local amt = math.max(1, math.floor(amount))
	local remote = F.findMailboxRemote()
	if remote then
		local callOk, resOk, timedOut, errMsg = F.callWithTimeout(remote.InvokeServer, Cfg.INVOKE_TIMEOUT, true, remote, recipient, message, "Pet", uid, amt)
		if timedOut then return false, "Server timeout (" .. tostring(Cfg.INVOKE_TIMEOUT) .. "s)", "Remote:" .. remote.Name end
		if callOk then
			if resOk == true then return true, nil, "Remote:" .. remote.Name end
			return false, tostring(errMsg or ("Server returned: " .. tostring(resOk))), "Remote:" .. remote.Name
		end
		return false, "InvokeServer error: " .. tostring(resOk), "Remote:" .. remote.Name
	end
	local netTable = (type(S.NetworkMod) == "table" and type(rawget(S.NetworkMod, "Invoke")) == "function" and S.NetworkMod)
		or (type(S.cachedGcNetwork) == "table" and type(rawget(S.cachedGcNetwork, "Invoke")) == "function" and S.cachedGcNetwork)
		or nil
	if netTable then
		local callOk, resOk, timedOut, errMsg = F.callWithTimeout(netTable.Invoke, Cfg.INVOKE_TIMEOUT, true, "EF_Relay", recipient, message, "Pet", uid, amt)
		if timedOut then return false, "Network.Invoke timeout (" .. tostring(Cfg.INVOKE_TIMEOUT) .. "s)", "Network.Invoke" end
		if callOk then
			if resOk == true then return true, nil, "Network.Invoke" end
			return false, tostring(errMsg or ("Server returned: " .. tostring(resOk))), "Network.Invoke"
		end
		return false, "Network.Invoke error: " .. tostring(resOk), "Network.Invoke"
	end
	return false, "Remote 'EF_Relay' / 'Mailbox: Send' not found", "None"
end

function F.pickBestLiveStack(targetLowerId, targetMutKey, remainingNeeded, maxRemainingByUid)
	local save = S.cachedSaveTable or F.resolveLiveSave(false)
	local inv = save and rawget(save, "Inventory")
	local invPets = type(inv) == "table" and rawget(inv, "Pet") or nil
	if type(invPets) ~= "table" then return nil, false end
	local eqCounts = F.getEquippedCountByUid(save)
	local bestCandidate = nil
	for uid, item in pairs(invPets) do
		if type(uid) == "string" and type(item) == "table" then
			local id = rawget(item, "id")
			if type(id) == "string" and string.lower(id) == targetLowerId and not F.isItemLocked(item) and F.itemMatchesExactMutation(item, targetMutKey) then
				local liveAm = F.getItemAmount(item)
				local cappedAm = maxRemainingByUid[uid] and math.min(liveAm, maxRemainingByUid[uid]) or liveAm
				local eqInStack = S.skipEquipped and math.min(cappedAm, eqCounts[uid] or (F.isItemMarkedEquipped(item) and 1 or 0)) or 0
				local avail = math.max(0, cappedAm - eqInStack)
				if avail > 0 then
					local fitRank = (avail == remainingNeeded and 1) or (avail > remainingNeeded and 2) or 3
					local cand = { uid = uid, avail = avail, cappedAm = cappedAm, fitRank = fitRank }
					if not bestCandidate or (cand.fitRank < bestCandidate.fitRank) or (cand.fitRank == bestCandidate.fitRank and ((cand.fitRank == 2 and cand.avail < bestCandidate.avail) or (cand.fitRank == 3 and cand.avail > bestCandidate.avail))) then
						bestCandidate = cand
					end
				end
			end
		end
	end
	return bestCandidate, true
end

function F.collectBatchCandidateUids(targetLowerId, targetMutKey)
	local save = S.cachedSaveTable or F.resolveLiveSave(false)
	local inv = save and rawget(save, "Inventory")
	local invPets = type(inv) == "table" and rawget(inv, "Pet") or nil
	if type(invPets) ~= "table" then return {}, false end
	local eqCounts = F.getEquippedCountByUid(save)
	local uids = {}
	for uid, item in pairs(invPets) do
		if type(uid) == "string" and type(item) == "table" then
			local id = rawget(item, "id")
			if type(id) == "string" and string.lower(id) == targetLowerId and not F.isItemLocked(item) and F.itemMatchesExactMutation(item, targetMutKey) then
				local liveAm = F.getItemAmount(item)
				local eqInStack = S.skipEquipped and math.min(liveAm, eqCounts[uid] or (F.isItemMarkedEquipped(item) and 1 or 0)) or 0
				if liveAm - eqInStack > 0 then table.insert(uids, { uid = uid, eq = eqInStack }) end
			end
		end
	end
	return uids, true
end

function F.pickFastBatchStack(batchList, targetLowerId, targetMutKey, remainingNeeded, maxRemainingByUid)
	local save = S.cachedSaveTable
	local inv = save and rawget(save, "Inventory")
	local invPets = type(inv) == "table" and rawget(inv, "Pet") or nil
	if type(invPets) ~= "table" then return nil, false end
	local bestCandidate = nil
	for i = #batchList, 1, -1 do
		local entry = batchList[i]
		local item = rawget(invPets, entry.uid)
		if type(item) ~= "table" or F.isItemLocked(item) then
			table.remove(batchList, i)
		else
			local liveAm = F.getItemAmount(item)
			local cappedAm = maxRemainingByUid[entry.uid] and math.min(liveAm, maxRemainingByUid[entry.uid]) or liveAm
			local eqInStack = S.skipEquipped and math.min(cappedAm, entry.eq) or 0
			local avail = math.max(0, cappedAm - eqInStack)
			if avail <= 0 then
				table.remove(batchList, i)
			else
				local fitRank = (avail == remainingNeeded and 1) or (avail > remainingNeeded and 2) or 3
				local cand = { uid = entry.uid, avail = avail, cappedAm = cappedAm, fitRank = fitRank }
				if not bestCandidate or (cand.fitRank < bestCandidate.fitRank) or (cand.fitRank == bestCandidate.fitRank and ((cand.fitRank == 2 and cand.avail < bestCandidate.avail) or (cand.fitRank == 3 and cand.avail > bestCandidate.avail))) then
					bestCandidate = cand
				end
				if bestCandidate.fitRank == 1 then break end
			end
		end
	end
	if bestCandidate then return bestCandidate, true end
	return F.pickBestLiveStack(targetLowerId, targetMutKey, remainingNeeded, maxRemainingByUid)
end

