function F.runSmartScan(forceGcSearch)
	if S.isScanning or S.isDestroyed then return end
	S.isScanning, UI.RefreshBtn.Text = true, "..."
	local t0 = os.clock()
	local okExec, errExec = pcall(function()
		if not S.modulesLoaded then
			F.setStatus("Loading game modules...", Color3.fromRGB(130, 200, 255))
			F.initGameModulesAsync()
		end
		if S.isDestroyed then return end
		local needGc = forceGcSearch or (S.cachedSaveTable == nil) or (F.scoreSaveTable(S.cachedSaveTable) <= 0)
		local ok, totalSendable, uniqueVariants, source = F.refreshInventoryCounts(needGc, function(msg) F.setStatus(msg, Color3.fromRGB(130, 200, 255)) end, false)
		if not ok and not S.isDestroyed then
			for retry = 1, 2 do
				F.setStatus("Waiting for Save data... retry (" .. tostring(retry) .. "/2)", Color3.fromRGB(245, 185, 95))
				task.wait(0.8)
				if S.isDestroyed then return end
				ok, totalSendable, uniqueVariants, source = F.refreshInventoryCounts(true, function(msg) F.setStatus(msg, Color3.fromRGB(130, 200, 255)) end, false)
				if ok then break end
			end
		end
		if S.isDestroyed then return end
		if S.selectedEntry and S.selectedEntry.pet then
			local rp = S.petByLowerId[S.selectedEntry.pet.lowerId]
			if rp then S.selectedEntry.pet = rp end
		end
		F.rebuildMutationBarUI()
		F.updateDiamondsUI()
		F.updateRecipientBadges()
		F.updateSearchResults(false)
		F.updateSelectedPreview()
		local remote = F.findMailboxRemote()
		local hasRemote = (remote ~= nil) or (type(S.NetworkMod) == "table" and type(rawget(S.NetworkMod, "Invoke")) == "function") or (type(S.cachedGcNetwork) == "table" and type(rawget(S.cachedGcNetwork, "Invoke")) == "function")
		local mailTag = remote and remote.Name or (hasRemote and "Network" or "Missing")
		if ok then
			F.setStatus(string.format("Scan OK [%s | %.2fs] | %d groups (%s avail) | %s", source, os.clock() - t0, uniqueVariants, F.formatNumber(totalSendable), mailTag), hasRemote and Color3.fromRGB(130, 220, 165) or Color3.fromRGB(245, 175, 95))
		else
			F.setStatus("Failed to read Save [" .. tostring(source) .. "] - press Scan again.", Color3.fromRGB(245, 135, 120))
		end
		if not S.catalogBuilt then
			F.trackThread(task.spawn(function()
				F.buildFullCatalogOnce(function()
					if not S.isDestroyed then F.updateSearchResults(true); F.updateSelectedPreview() end
				end)
			end))
		end
	end)
	S.isScanning = false
	if not S.isDestroyed then UI.RefreshBtn.Text = "Scan" end
	if not okExec then F.setStatus("Scan error: " .. tostring(errExec), Color3.fromRGB(245, 110, 110)) end
end

function F.waitInterruptible(seconds, statusPrefix)
	if seconds <= 0 then return not (S.cancelRequested or S.isDestroyed) end
	if not statusPrefix and seconds <= 0.35 then
		task.wait(seconds)
		return not (S.cancelRequested or S.isDestroyed)
	end
	local deadline, lastShown = os.clock() + seconds, -1
	while os.clock() < deadline do
		if S.cancelRequested or S.isDestroyed then return false end
		if statusPrefix then
			local leftSec = math.max(1, math.ceil(deadline - os.clock()))
			if leftSec ~= lastShown then
				lastShown = leftSec
				F.setStatus(string.format("%s (%ds)...", statusPrefix, leftSec), Color3.fromRGB(245, 200, 110))
			end
		end
		task.wait(math.min(0.1, math.max(0.01, deadline - os.clock())))
	end
	return not (S.cancelRequested or S.isDestroyed)
end

