function F.parseCooldownSeconds(errStr, attempt)
	local lower = string.lower(errStr or "")
	local totalParsed = nil
	local mStr, sStr = string.match(lower, "(%d+%.?%d*)%s*m[a-z]*%s*(%d+%.?%d*)%s*s")
	if mStr and sStr then
		local mins, secs = tonumber(mStr), tonumber(sStr)
		if mins and secs then totalParsed = mins * 60 + secs end
	end
	if not totalParsed then
		local minOnly = string.match(lower, "(%d+%.?%d*)%s*min") or string.match(lower, "(%d+%.?%d*)%s*m$") or string.match(lower, "(%d+%.?%d*)%s*m[^a-z]")
		local mins = tonumber(minOnly)
		if mins and F.isValidFiniteNumber(mins) and mins > 0 and mins <= 5 then totalParsed = mins * 60 end
	end
	if not totalParsed then
		local secs = tonumber(string.match(lower, "(%d+%.?%d*)%s*s") or string.match(lower, "(%d+%.?%d*)"))
		if secs and F.isValidFiniteNumber(secs) and secs > 0 and secs <= 180 then totalParsed = secs end
	end
	if totalParsed and F.isValidFiniteNumber(totalParsed) and totalParsed > 0 and totalParsed <= 180 then
		return math.clamp(totalParsed + 0.08, 0.25, 180.5), true
	end
	return (attempt <= 6 and 0.35) or (attempt <= 14 and 0.55) or 0.85, false
end

