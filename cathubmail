	local function cleanup()
		if S.isDestroyed then return end
		S.isDestroyed, S.cancelRequested, S.isSending, S.isScanning = true, true, false, false
		for _, k in ipairs({ "activeTimeoutThread", "activeInvokeThread", "sendThread" }) do
			if S[k] and coroutine.status(S[k]) ~= "dead" then pcall(task.cancel, S[k]) end
			S[k] = nil
		end
		for i = #S.activeThreads, 1, -1 do
			if S.activeThreads[i] and coroutine.status(S.activeThreads[i]) ~= "dead" then pcall(task.cancel, S.activeThreads[i]) end
			S.activeThreads[i] = nil
		end
		F.clearConnList(S.mutConnections)
		F.clearConnList(S.connections)
		if UI.ScreenGui and UI.ScreenGui.Parent then UI.ScreenGui:Destroy() end
	end
