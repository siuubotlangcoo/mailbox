	F.trackConn(UI.TabMultiBtn.MouseButton1Click:Connect(function() if not S.isSending and S.sendMode ~= "multi" then F.applySendModeUI("multi") end end))

	local function sanitizeSingleBox(isFinal)
		if S.sanitizingSingleBox then return end
		local raw = UI.SingleUserBox.Text or ""
		local hasMulti = (string.find(raw, "[\r\n|,;%s]") ~= nil)
		if hasMulti or isFinal then
			local first = ""
			for seg in string.gmatch(raw, "([^|\r\n,;%s]+)") do
				local clean = string.gsub(seg, "[^A-Za-z0-9_]", "")
				if clean ~= "" then first = string.sub(clean, 1, 20); break end
			end
			if first ~= raw then
				S.sanitizingSingleBox = true; UI.SingleUserBox.Text = first; S.sanitizingSingleBox = false
				S.singleWarnNote = hasMulti and "1 acc only (kept first)" or nil
			else
				S.singleWarnNote = nil
			end
		else
			local clean = string.sub(string.gsub(raw, "[^A-Za-z0-9_]", ""), 1, 20)
			if clean ~= raw then S.sanitizingSingleBox = true; UI.SingleUserBox.Text = clean; S.sanitizingSingleBox = false end
			S.singleWarnNote = nil
		end
	end

	F.trackConn(UI.SingleUserBox:GetPropertyChangedSignal("Text"):Connect(function() pcall(function() sanitizeSingleBox(false); F.updateRecipientBadges(); F.updateSelectedPreview() end) end))
	F.trackConn(UI.SingleUserBox.FocusLost:Connect(function() pcall(function() sanitizeSingleBox(true); F.updateRecipientBadges(); F.updateSelectedPreview() end) end))
